<div class="modal fade show" style="display:block;" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content orange-theme">

      <div class="modal-header">
        <h5 class="modal-title">PDF Not Ready</h5>

        <button type="button"
                class="btn-close"
                onclick="document.getElementById('modals-here').innerHTML = ''"></button>
      </div>

      <div class="modal-body">
        <p>
          This PDF has not yet been prepared for download.
        </p>

        <p>
          Please check back later.
        </p>
      </div>

      <div class="modal-footer">
        <button type="button"
                class="btn btn-secondary"
                onclick="document.getElementById('modals-here').innerHTML = ''">
          Close
        </button>
      </div>

    </div>
  </div>
</div>